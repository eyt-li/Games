<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MatchBoard</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; background: #f9fafb; }
  .match-card { border-left: 4px solid #10b981; border-radius: 8px; background-color: rgba(16, 185, 129, 0.08); }
  .score-box { background: white; border: 2px solid #d1d5db; border-radius: 6px; width: 44px; height: 36px; text-align: center; font-weight: 600; font-size: 14px; transition: all 0.2s; }
  .score-box:focus { border-color: #3b82f6; outline: none; box-shadow: 0 0 0 2px rgba(59,130,246,0.2); }
  .score-box.filled { background: #f0fdf4; border-color: #10b981; color: #065f46; }
  .court-badge { background: #f3f4f6; border-radius: 4px; padding: 2px 6px; font-size: 10px; font-weight: 600; color: #6b7280; }
  .group-badge { background: rgba(59, 130, 246, 0.15); color: #1d4ed8; border-radius: 4px; padding: 2px 6px; font-size: 11px; font-weight: 600; }
  .cat-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .live-pulse { animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
  .tab-active { background: white; border: 1px solid #e5e7eb; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
  .tab-inactive { background: transparent; border: 1px solid transparent; }
  input[type="text"], input[type="number"], input[type="date"], input[type="time"], select {
    border: 1px solid #d1d5db; border-radius: 6px; padding: 6px 10px; font-size: 13px; outline: none;
  }
  input:focus, select:focus { border-color: #3b82f6; box-shadow: 0 0 0 2px rgba(59,130,246,0.2); }
  input:disabled { background: #f3f4f6; color: #6b7280; cursor: not-allowed; }
  .btn { padding: 6px 10px; border-radius: 6px; font-size: 12px; font-weight: 500; border: 1px solid #d1d5db; background: white; cursor: pointer; transition: all 0.15s; }
  .btn:hover { background: #f9fafb; }
  .color-dot { width: 22px; height: 22px; border-radius: 50%; cursor: pointer; border: 2px solid transparent; }
  .color-dot.selected { border-color: #1f2937; }
  .color-picker-wrapper { width: 26px; height: 26px; border-radius: 6px; overflow: hidden; border: 1px solid #d1d5db; cursor: pointer; position: relative; }
  .color-picker-wrapper input[type="color"] { position: absolute; top: -4px; left: -4px; width: 34px; height: 34px; border: none; cursor: pointer; }
  .standings-table th { font-size: 10px; text-transform: uppercase; color: #6b7280; font-weight: 500; letter-spacing: 0.05em; }
  .standings-table td { font-size: 13px; padding: 8px 10px; }
  .schedule-row:nth-child(even) { background: #eff6ff; }
  .schedule-row:hover { background: #dbeafe; }
  .team-chip input { width: 70px; }
  .group-select { padding: 3px 6px; font-size: 11px; border-radius: 4px; border: 1px solid #d1d5db; background: white; }
  .time-slot-header { background: #f3f4f6; padding: 6px 12px; font-weight: 600; font-size: 12px; color: #374151; border-radius: 6px; margin-bottom: 6px; display: flex; align-items: center; gap: 6px; }
  .time-slot-header .clock { font-size: 13px; color: #1f2937; }
  .header-btn { padding: 6px 12px; border-radius: 8px; font-size: 13px; font-weight: 500; border: 1px solid #e5e7eb; background: white; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.15s; }
  .header-btn:hover { background: #f9fafb; }
  .header-btn.active { background: #10b981; color: white; border-color: #10b981; }
  .header-btn.active:hover { background: #059669; }
  .hidden { display: none !important; }
  .password-modal { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 100; }
  .password-box { background: white; padding: 24px; border-radius: 12px; width: 320px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
</style>
</head>
<body>

<!-- HEADER -->
<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 py-2 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <svg class="w-5 h-5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05A3.989 3.989 0 0115 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.715-5.349L11 6.477V16h2a1 1 0 110 2H7a1 1 0 110-2h2V6.477L6.237 7.582l1.715 5.349a1 1 0 01-.285 1.05A3.989 3.989 0 015 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.738-5.42-1.233-.617a1 1 0 01.894-1.788l1.599.799L9 4.323V3a1 1 0 011-1z"/></svg>
      <span class="font-semibold text-gray-900 text-sm">MatchBoard</span>
      <span class="text-gray-400 text-xs">/</span>
      <select id="scheduleName" class="border-0 bg-transparent font-medium text-gray-900 focus:ring-0 p-0 text-sm">
        <option>Schedule 1</option>
      </select>
    </div>
    <div class="flex items-center gap-2">
      <div class="flex items-center gap-1.5 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
        <span class="w-2 h-2 bg-emerald-500 rounded-full live-pulse"></span>
        <span class="text-xs font-medium text-emerald-700">Live</span>
      </div>
      <button id="shareBtn" class="header-btn">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
        Share
      </button>
      <button id="editModeBtn" class="header-btn">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        <span id="editModeText">Edit</span>
      </button>
    </div>
  </div>
</header>

<!-- PASSWORD MODAL -->
<div id="passwordModal" class="password-modal hidden">
  <div class="password-box">
    <h3 class="font-semibold text-gray-900 mb-3">Enter Password</h3>
    <input type="password" id="passwordInput" placeholder="Password" class="w-full mb-3" onkeypress="if(event.key==='Enter') checkPassword()">
    <div class="flex gap-2">
      <button onclick="closePasswordModal()" class="btn flex-1">Cancel</button>
      <button onclick="checkPassword()" class="btn flex-1 bg-emerald-500 text-white border-emerald-500 hover:bg-emerald-600">Unlock</button>
    </div>
    <p id="passwordError" class="text-red-500 text-xs mt-2 hidden">Incorrect password</p>
  </div>
</div>

<!-- TABS -->
<div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
  <div class="flex gap-2">
    <button id="tabCategory" class="tab-active px-3 py-1.5 rounded-lg text-sm font-medium flex items-center gap-1.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
      Category
    </button>
    <button id="tabSchedule" class="tab-inactive px-3 py-1.5 rounded-lg text-sm font-medium flex items-center gap-1.5 text-gray-600">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
      Full schedule
    </button>
  </div>
  <div class="flex items-center gap-2">
    <span id="matchCount" class="text-xs text-gray-500">0 matches</span>
    <button id="exportPdfBtn" class="btn flex items-center gap-1.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      Export PDF
    </button>
  </div>
</div>

<!-- CATEGORY VIEW -->
<div id="categoryView" class="max-w-7xl mx-auto px-4 pb-12">
  <div class="grid grid-cols-12 gap-4">

    <!-- LEFT: SETUP PANEL -->
    <div class="col-span-4">
      <div class="bg-white rounded-lg border border-gray-200 p-4">
        <h3 class="font-semibold text-gray-900 text-sm mb-3 flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05A3.989 3.989 0 0115 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.715-5.349L11 6.477V16h2a1 1 0 110 2H7a1 1 0 110-2h2V6.477L6.237 7.582l1.715 5.349a1 1 0 01-.285 1.05A3.989 3.989 0 015 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.738-5.42-1.233-.617a1 1 0 01.894-1.788l1.599.799L9 4.323V3a1 1 0 011-1z"/></svg>
          Setup
        </h3>

        <div class="space-y-3">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Event name</label>
            <input type="text" id="eventName" placeholder="e.g. 3 Damansara Floorball Carnival" class="w-full">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Date</label>
            <input type="date" id="eventDate" class="w-full">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Day starts</label>
            <input type="time" id="dayStarts" value="08:30" class="w-full">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Play until</label>
            <input type="time" id="playUntil" value="11:30" class="w-full">
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1">Match (min)</label>
              <input type="number" id="matchMin" value="10" class="w-full">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1">Courts</label>
              <input type="number" id="courts" value="2" class="w-full">
            </div>
          </div>
          <div id="passwordSection" class="hidden border-t border-gray-100 pt-3 space-y-2">
            <label class="block text-xs font-medium text-gray-700">Change edit password</label>
            <input type="password" id="newPassword" placeholder="New password" class="w-full">
            <input type="password" id="confirmPassword" placeholder="Confirm new password" class="w-full" onkeypress="if(event.key==='Enter') changePassword()">
            <button class="btn w-full" onclick="changePassword()">Update password</button>
            <p id="passwordMsg" class="text-xs hidden"></p>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT: CATEGORIES & MATCHES -->
    <div class="col-span-8 space-y-4">

      <!-- NEXT UP -->
      <div class="bg-white rounded-lg border border-gray-200 p-4">
        <div class="flex items-center gap-2 text-xs font-medium text-gray-700 mb-2">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          Next up
        </div>
        <div id="nextUp" class="text-gray-900 text-sm">
          <span class="text-gray-500">No matches scheduled yet</span>
        </div>
      </div>

      <!-- CATEGORIES CONTAINER -->
      <div id="categoriesContainer"></div>

      <!-- ADD CATEGORY -->
      <button id="addCategoryBtn" class="hidden w-full bg-white border-2 border-dashed border-gray-300 rounded-lg py-3 text-gray-700 text-sm font-medium hover:border-gray-400 hover:bg-gray-50 transition flex items-center justify-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add category (<span id="catCount">0</span>/12)
      </button>
    </div>
  </div>
</div>

<!-- FULL SCHEDULE VIEW -->
<div id="scheduleView" class="max-w-7xl mx-auto px-4 pb-12 hidden">
  <div class="bg-white rounded-lg border border-gray-200 p-4">
    <h2 class="text-base font-semibold text-gray-900 mb-3">Full schedule — <span id="totalMatches">0</span> matches</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-left text-xs text-gray-500 uppercase">
            <th class="py-2 px-2">Time</th>
            <th class="py-2 px-2">Court</th>
            <th class="py-2 px-2">Category</th>
            <th class="py-2 px-2">Group</th>
            <th class="py-2 px-2">Round</th>
            <th class="py-2 px-2">Status</th>
            <th class="py-2 px-2 text-right">Home</th>
            <th class="py-2 px-2 text-center">Score</th>
            <th class="py-2 px-2">Away</th>
          </tr>
        </thead>
        <tbody id="scheduleBody"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
// ============================================
// FIREBASE CONFIG
// ============================================
const firebaseConfig = {
  apiKey: "YOUR_API_KEY",
  authDomain: "YOUR_PROJECT.firebaseapp.com",
  databaseURL: "https://YOUR_PROJECT-default-rtdb.firebaseio.com",
  projectId: "YOUR_PROJECT",
  storageBucket: "YOUR_PROJECT.appspot.com",
  messagingSenderId: "123456789",
  appId: "1:123456789:web:abcdef"
};

let db = null;
try {
  if (firebaseConfig.apiKey !== "YOUR_API_KEY") {
    firebase.initializeApp(firebaseConfig);
    db = firebase.database();
  }
} catch (e) { console.log("Firebase not configured"); }
const DB_PATH = 'matchboard/schedule1';

// ============================================
// HELPERS
// ============================================
function defaultDate() {
  const d = new Date(); d.setDate(d.getDate() + 1);
  return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
}
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const toMin = s => { const [h, m] = String(s).split(':').map(Number); return (h || 0) * 60 + (m || 0); };
const getCat = id => state.categories.find(c => c.id === id);
const groupLetters = n => Array.from({ length: n }, (_, i) => String.fromCharCode(65 + i));
const isGrouped = c => c.format === 'groups-playoffs';
const done = m => m.score1 !== '' && m.score2 !== '' && !isNaN(m.score1) && !isNaN(m.score2);
const ord = p => ['1st', '2nd', '3rd', '4th'][p - 1];
const matchOrder = (a, b) => (a.slot - b.slot) || (a.courtNo - b.courtNo);
const safeId = s => s.replace(/[.#$\[\]\/\s|]/g, '_');
const pairKey = (g, a, b) => (g || '') + '|' + [a, b].sort().join('|');

function hexToRgba(hex, alpha) {
  const r = parseInt(hex.slice(1, 3), 16), g = parseInt(hex.slice(3, 5), 16), b = parseInt(hex.slice(5, 7), 16);
  return `rgba(${r}, ${g}, ${b}, ${alpha})`;
}
function formatTime(totalMinutes) {
  const h = Math.floor(totalMinutes / 60) % 24, m = totalMinutes % 60;
  return `${h % 12 || 12}:${m.toString().padStart(2, '0')} ${h >= 12 ? 'PM' : 'AM'}`;
}
// The date comes from shared state, so every viewer sees the same day
function dayHeader(d) {
  if (!state.eventDate) return `DAY ${d + 1}`;
  const [y, m, day] = state.eventDate.split('-').map(Number);
  return `DAY ${d + 1} · ` + new Date(y, m - 1, day + d)
    .toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }).toUpperCase();
}
function teamGroup(cat, i) {
  const g = (cat.teamGroups && cat.teamGroups[i]) || 'A';
  return (g.charCodeAt(0) - 65 < (cat.groups || 1)) ? g : 'A';
}
function alignGroups(cat) {
  cat.teamGroups = cat.teamGroups || [];
  while (cat.teamGroups.length < cat.teams.length) cat.teamGroups.push('A');
  cat.teamGroups.length = cat.teams.length;
}

// ============================================
// STATE
// ============================================
let state = { pwHash: '', eventName: '3 Damansara Floorball Carnival', eventDate: defaultDate(), dayStarts: "08:30", playUntil: "11:30", matchMin: 10, courts: 2, categories: [] };
let editMode = false;
let echo = false;
let loaded = !db;          // never write to Firebase before its first snapshot has arrived
let pendingRemote = null;
const COLORS = ['#10b981', '#3b82f6', '#f59e0b', '#8b5cf6', '#ef4444', '#06b6d4'];
let savedGroupSelections = {};
// Used until a new password is set from the Setup panel. The new password is stored as a hash
// in the shared data. This only hides the edit buttons: protect writes with Firebase Auth +
// database rules (e.g. ".write": "auth != null") if you need real security.
const DEFAULT_PASSWORD = 'admin123';
const SETUP_IDS = ['eventName', 'eventDate', 'dayStarts', 'playUntil', 'matchMin', 'courts'];

// ============================================
// PASSWORD MODAL / EDIT MODE
// ============================================
document.getElementById('editModeBtn').addEventListener('click', () => {
  if (editMode) {
    editMode = false;
    document.getElementById('editModeBtn').classList.remove('active');
    document.getElementById('editModeText').textContent = 'Edit';
    render();
  } else {
    document.getElementById('passwordModal').classList.remove('hidden');
    document.getElementById('passwordInput').value = '';
    document.getElementById('passwordError').classList.add('hidden');
    setTimeout(() => document.getElementById('passwordInput').focus(), 100);
  }
});

async function hashPw(pw, method) {
  const text = 'matchboard:' + pw;
  if (method !== 'h0' && window.crypto && crypto.subtle) {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
    return 'h1:' + Array.from(new Uint8Array(buf)).map(x => x.toString(16).padStart(2, '0')).join('');
  }
  let h = 5381;
  for (const c of text) h = ((h << 5) + h + c.charCodeAt(0)) | 0;
  return 'h0:' + (h >>> 0).toString(16);
}

async function changePassword() {
  if (!editMode) return;
  const p1 = document.getElementById('newPassword').value;
  const p2 = document.getElementById('confirmPassword').value;
  const msg = document.getElementById('passwordMsg');
  const show = (t, ok) => { msg.textContent = t; msg.className = 'text-xs ' + (ok ? 'text-emerald-600' : 'text-red-500'); };
  if (p1.length < 4) return show('Use at least 4 characters.', false);
  if (p1 !== p2) return show('Passwords do not match.', false);
  state.pwHash = await hashPw(p1);
  save();
  document.getElementById('newPassword').value = '';
  document.getElementById('confirmPassword').value = '';
  show('Password updated.', true);
}

async function checkPassword() {
  const input = document.getElementById('passwordInput').value;
  let ok;
  if (!state.pwHash) ok = input === DEFAULT_PASSWORD;
  else ok = (await hashPw(input, state.pwHash.slice(0, 2))) === state.pwHash;
  if (ok) {
    editMode = true;
    document.getElementById('editModeBtn').classList.add('active');
    document.getElementById('editModeText').textContent = 'Editing';
    document.getElementById('passwordModal').classList.add('hidden');
    render();
  } else {
    document.getElementById('passwordError').classList.remove('hidden');
  }
}
function closePasswordModal() { document.getElementById('passwordModal').classList.add('hidden'); }
document.addEventListener('keydown', e => { if (e.key === 'Escape') closePasswordModal(); });

// View-only users can't touch the setup or add categories
function applyModeUI() {
  SETUP_IDS.forEach(id => { document.getElementById(id).disabled = !editMode; });
  document.getElementById('addCategoryBtn').classList.toggle('hidden', !editMode);
  document.getElementById('passwordSection').classList.toggle('hidden', !editMode);
}

// ============================================
// PERSISTENCE
// ============================================
function save() {
  if (!db || !loaded) return;
  echo = true;
  try { db.ref(DB_PATH).set(JSON.parse(JSON.stringify(state))); } catch (e) { console.error(e); }
  echo = false;
}
function saveScore(cat, m, side, value) {
  if (!db || !loaded) return;
  const ci = state.categories.indexOf(cat), mi = cat.matches.indexOf(m);
  echo = true;
  try { db.ref(`${DB_PATH}/categories/${ci}/matches/${mi}/score${side}`).set(value); } catch (e) { console.error(e); }
  echo = false;
}
function normalize(d) {
  const arr = x => Array.isArray(x) ? x.filter(v => v != null) : (x ? Object.values(x) : []);
  const s = { pwHash: d.pwHash || '', eventName: d.eventName ?? '', eventDate: d.eventDate || defaultDate(), dayStarts: d.dayStarts || '08:30', playUntil: d.playUntil || '11:30', matchMin: +d.matchMin || 10, courts: +d.courts || 2, categories: arr(d.categories) };
  s.categories.forEach(c => {
    c.teams = arr(c.teams); c.teamGroups = arr(c.teamGroups); c.matches = arr(c.matches);
