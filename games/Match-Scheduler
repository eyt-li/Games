// ============================================
// MATCH GENERATION
// ============================================
function rrRounds(teams) {
  const t = [...teams];
  if (t.length % 2) t.push(null);
  const n = t.length, rounds = [];
  for (let r = 0; r < n - 1; r++) {
    const pairs = [];
    for (let i = 0; i < n / 2; i++) {
      const a = t[i], b = t[n - 1 - i];
      if (a && b) pairs.push([a, b]);
    }
    rounds.push(pairs);
    t.splice(1, 0, t.pop());
  }
  return rounds;
}

function koDefs(cat, groups, groupIds) {
  const n = cat.teams.length;
  const seed = (g, p) => ({ t: 'seed', g: g || undefined, p });
  const top = (g, size) => {
    const k = size >= 4 ? 4 : size >= 2 ? 2 : 0;
    const s = [1, 2, 3, 4].slice(0, k).map(p => seed(g, p));
    return k === 4 ? [s[0], s[3], s[1], s[2]] : s;
  };
  let q = [];
  if (cat.format === 'round-robin-knockouts') q = top(null, n);
  else if (isGrouped(cat)) {
    const gs = Object.keys(groups).sort();
    if (gs.length === 1) q = top(gs[0], n);
    else if (gs.length === 2 && gs.every(g => groups[g].length >= 2)) q = [seed(gs[0], 1), seed(gs[1], 2), seed(gs[1], 1), seed(gs[0], 2)];
    else if (gs.length === 4) q = gs.map(g => seed(g, 1));
  }
  const mk = (id, round, r1, r2, deps) => ({ id, stage: 'ko', round, group: null, team1: null, team2: null, ref1: r1, ref2: r2, deps, score1: '', score2: '' });
  if (q.length === 4) return [
    mk('sf1', 'Semi-final 1', q[0], q[1], groupIds),
    mk('sf2', 'Semi-final 2', q[2], q[3], groupIds),
    mk('final', 'Final', { t: 'win', m: 'sf1' }, { t: 'win', m: 'sf2' }, ['sf1', 'sf2'])
  ];
  if (q.length === 2) return [mk('final', 'Final', q[0], q[1], groupIds)];
  return [];
}

function buildMatches(cat) {
  const old = {};
  cat.matches.forEach(m => { old[m.stage === 'ko' ? 'ko:' + m.id : pairKey(m.group, m.team1, m.team2)] = m; });
  alignGroups(cat);
  const groups = {};
  cat.teams.forEach((t, i) => { const g = isGrouped(cat) ? teamGroup(cat, i) : '_'; (groups[g] = groups[g] || []).push(t); });
  const perGroup = Object.keys(groups).sort().map(g => ({ g, rounds: rrRounds(groups[g]) }));
  const maxR = Math.max(0, ...perGroup.map(x => x.rounds.length));
  const list = [];
  for (let r = 0; r < maxR; r++) {
    perGroup.forEach(({ g, rounds }) => (rounds[r] || []).forEach(([a, b]) => {
      const group = isGrouped(cat) ? g : null;
      const prev = old[pairKey(group, a, b)];
      const m = { id: safeId(`g_${group || 'x'}_${a}_${b}`), stage: 'group', round: 'Group stage', group, team1: a, team2: b, score1: '', score2: '' };
      if (prev) { const same = prev.team1 === a; m.score1 = same ? prev.score1 : prev.score2; m.score2 = same ? prev.score2 : prev.score1; }
      list.push(m);
    }));
  }
  const groupIds = list.map(m => m.id);
  koDefs(cat, groups, groupIds).forEach(k => {
    const prev = old['ko:' + k.id];
    if (prev) { k.score1 = prev.score1; k.score2 = prev.score2; }
    list.push(k);
  });
  cat.matches = list;
}

// ============================================
// GLOBAL SCHEDULER
// ============================================
function scheduleAll() {
  const courts = Math.max(1, parseInt(state.courts) || 1);
  const mm = Math.max(1, parseInt(state.matchMin) || 10);
  const start = toMin(state.dayStarts);
  const perDay = Math.max(1, Math.floor((toMin(state.playUntil) - start) / mm));
  const cats = state.categories;
  const pend = cats.map(c => [...c.matches]);
  const slotOf = cats.map(() => ({}));
  let left = pend.reduce((s, p) => s + p.length, 0), slot = 0;
  let prev = cats.map(() => new Set());

  while (left > 0 && slot < 5000) {
    const used = cats.map(() => new Set());
    let n = 0, progress = true;
    const pick = (ci, rest) => {
      const idx = pend[ci].findIndex(m => {
        if (!(m.deps || []).every(d => slotOf[ci][d] !== undefined && slotOf[ci][d] < slot)) return false;
        if (m.stage === 'ko') return true;
        if (used[ci].has(m.team1) || used[ci].has(m.team2)) return false;
        return !rest || (!prev[ci].has(m.team1) && !prev[ci].has(m.team2));
      });
      return idx < 0 ? null : pend[ci].splice(idx, 1)[0];
    };
    while (n < courts && progress) {
      progress = false;
      for (let k = 0; k < cats.length && n < courts; k++) {
        const ci = (k + slot) % cats.length;
        const m = pick(ci, true) || pick(ci, false);
        if (!m) continue;
        n++; left--; progress = true;
        slotOf[ci][m.id] = slot;
        used[ci].add(m.team1); used[ci].add(m.team2);
        const t = start + (slot % perDay) * mm;
        Object.assign(m, { slot, day: Math.floor(slot / perDay), timeMin: t, time: formatTime(t), courtNo: n, court: 'C' + n });
      }
    }
    prev = used;
    slot++;
  }
  cats.forEach(c => c.matches.sort(matchOrder));
}

// ============================================
// STANDINGS & KNOCKOUT RESOLUTION
// ============================================
function computeStandings(cat) {
  const res = {};
  const ensure = (g, t) => { res[g] = res[g] || {}; return res[g][t] = res[g][t] || { name: t, p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 }; };
  cat.teams.forEach((t, i) => ensure(isGrouped(cat) ? teamGroup(cat, i) : '_', t));
  cat.matches.forEach(m => {
    if (m.stage === 'ko' || !done(m)) return;
    const g = m.group || '_', a = ensure(g, m.team1), b = ensure(g, m.team2);
    const s1 = parseInt(m.score1), s2 = parseInt(m.score2);
    a.p++; b.p++; a.gf += s1; a.ga += s2; b.gf += s2; b.ga += s1;
    if (s1 > s2) { a.w++; a.pts += 2; b.l++; }
    else if (s2 > s1) { b.w++; b.pts += 2; a.l++; }
    else { a.d++; b.d++; a.pts++; b.pts++; }
  });
  Object.keys(res).forEach(g => {
    res[g] = Object.values(res[g]).sort((a, b) =>
      (b.pts - a.pts) || ((b.gf - b.ga) - (a.gf - a.ga)) || (b.gf - a.gf) || a.name.localeCompare(b.name));
  });
  return res;
}
const groupStageDone = cat => { const g = cat.matches.filter(m => m.stage !== 'ko'); return g.length > 0 && g.every(done); };

function resolveRef(cat, ref) {
  if (!ref) return null;
  if (ref.t === 'seed') {
    if (!groupStageDone(cat)) return null;
    const list = computeStandings(cat)[ref.g || '_'];
    return list && list[ref.p - 1] ? list[ref.p - 1].name : null;
  }
  const m = cat.matches.find(x => x.id === ref.m);
  if (!m || !done(m)) return null;
  const a = +m.score1, b = +m.score2;
  if (a === b) return null;
  return a > b ? resolveRef(cat, m.ref1) : resolveRef(cat, m.ref2);
}
function displayName(cat, m, side) {
  if (m.stage !== 'ko') return side === 1 ? m.team1 : m.team2;
  const ref = side === 1 ? m.ref1 : m.ref2;
  const name = resolveRef(cat, ref);
  if (name) return name;
  if (ref.t === 'seed') return ord(ref.p) + (ref.g ? ` Group ${ref.g}` : ' place');
  const src = cat.matches.find(x => x.id === ref.m);
  return 'Winner ' + (src ? src.round.replace('Semi-final ', 'SF') : '?');
}

