// ============================================
// EXPORT PDF
// ============================================
function exportPDF() {
  if (!window.jspdf || !window.jspdf.jsPDF) { toast('The PDF library could not load. Check your internet connection and try again.'); return; }
  const all = allMatches();
  if (!all.length) { toast('There are no matches to export yet.'); return; }
  const doc = new window.jspdf.jsPDF({ unit: 'pt', format: 'a4' });
  if (typeof doc.autoTable !== 'function') { toast('The PDF table plugin could not load. Please try again.'); return; }

  const mm = parseInt(state.matchMin) || 10;
  const showCourt = (parseInt(state.courts) || 1) > 1;
  const hhmm = t => { t = ((t % 1440) + 1440) % 1440; return String(Math.floor(t / 60)).padStart(2, '0') + ':' + String(t % 60).padStart(2, '0'); };
  const title = ((state.eventName || '').trim() + ' SCHEDULE').trim().toUpperCase();
  const number = new Map();
  all.forEach((x, i) => number.set(x.m, i + 1));

  const pdfName = (cat, m, side) => {
    if (m.stage !== 'ko') return side === 1 ? m.team1 : m.team2;
    const ref = side === 1 ? m.ref1 : m.ref2;
    const n = resolveRef(cat, ref);
    if (n) return n;
    if (ref.t === 'seed') return ref.g ? `${ref.p}${ref.g}` : ord(ref.p) + ' place';
    const src = cat.matches.find(x => x.id === ref.m);
    return 'Winner ' + (src ? src.round.replace('Semi-final ', 'SF') : '?');
  };
  const catLabel = (cat, m) => {
    if (m.stage === 'ko') return `${cat.name} (${m.round === 'Final' ? 'FINAL' : m.round.replace('Semi-final', 'Semi-Final')})`;
    if (m.group) return `${cat.name} (Group ${m.group})`;
    return `${cat.name} (${cat.format === 'round-robin' ? 'Single Group RR' : 'Round Robin'})`;
  };
  const dayLabel = d => {
    if (!state.eventDate) return `DAY ${d + 1}`;
    const [y, mo, da] = state.eventDate.split('-').map(Number);
    return `DAY ${d + 1}: ` + new Date(y, mo - 1, da + d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).toUpperCase();
  };

  const head = ['Match #', 'Time'].concat(showCourt ? ['Court'] : [], ['Game', 'Category']);
  const days = [...new Set(all.map(x => x.m.day))].sort((a, b) => a - b);
  days.forEach((d, di) => {
    if (di > 0) doc.addPage();
    doc.setFont('times', 'normal'); doc.setFontSize(11); doc.setTextColor(0);
    doc.text(title, 40, 50);
    doc.text(dayLabel(d), 40, 80);
    const rows = all.filter(x => x.m.day === d).map(({ cat, m }) => ({
      ko: m.stage === 'ko',
      cells: ['M' + number.get(m), `${hhmm(m.timeMin)}-${hhmm(m.timeMin + mm)}`]
        .concat(showCourt ? [m.court] : [], [`${pdfName(cat, m, 1)} vs ${pdfName(cat, m, 2)}`, catLabel(cat, m)])
    }));
    const columnStyles = showCourt
      ? { 0: { cellWidth: 42 }, 1: { cellWidth: 66 }, 2: { cellWidth: 36 }, 4: { cellWidth: 150 } }
      : { 0: { cellWidth: 42 }, 1: { cellWidth: 66 }, 3: { cellWidth: 160 } };
    doc.autoTable({
      startY: 96,
      head: [head],
      body: rows.map(r => r.cells),
      theme: 'grid',
      margin: { left: 40, right: 40, top: 40, bottom: 40 },
      styles: { font: 'helvetica', fontSize: 8, cellPadding: 2.5, halign: 'center', valign: 'middle', lineColor: [0, 0, 0], lineWidth: 0.4, textColor: 0 },
      headStyles: { fillColor: [31, 78, 121], textColor: 255, fontStyle: 'bold' },
      columnStyles,
      didParseCell: data => {
        if (data.section === 'body' && rows[data.row.index].ko) data.cell.styles.fillColor = [255, 255, 0];
      }
    });
  });
  const fname = ((state.eventName || 'matchboard').trim() || 'matchboard').replace(/[^\w\- ]+/g, '').replace(/\s+/g, '-').toLowerCase();
  doc.save(fname + '-schedule.pdf');
}
document.getElementById('exportPdfBtn').addEventListener('click', exportPDF);

// ============================================
// SHARE
// ============================================
function toast(text) {
  let t = document.getElementById('toast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'toast';
    t.className = 'fixed bottom-6 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-sm px-4 py-2 rounded-lg shadow-lg transition-opacity';
    t.style.zIndex = '300';
    document.body.appendChild(t);
  }
  t.textContent = text;
  t.style.opacity = '1';
  clearTimeout(t._h);
  t._h = setTimeout(() => { t.style.opacity = '0'; }, 2800);
}


// In-page dialogs (browsers block alert/confirm/prompt inside embedded previews)
function showModal(html) {
  const o = document.createElement('div');
  o.className = 'password-modal';
  o.style.zIndex = '200';
  o.innerHTML = `<div class="password-box">${html}</div>`;
  o.addEventListener('click', e => { if (e.target === o) o.remove(); });
  document.body.appendChild(o);
  return o;
}
function confirmDialog(message, onYes, yesLabel) {
  const o = showModal(`<p class="text-sm text-gray-800 mb-4">${esc(message)}</p>
    <div class="flex gap-2">
      <button class="btn flex-1" data-n>Cancel</button>
      <button class="btn flex-1 bg-red-500 text-white border-red-500 hover:bg-red-600" data-y>${esc(yesLabel || 'Remove')}</button>
    </div>`);
  o.querySelector('[data-n]').onclick = () => o.remove();
  o.querySelector('[data-y]').onclick = () => { o.remove(); onYes(); };
}
function linkDialog(url, note) {
  const o = showModal(`<h3 class="font-semibold text-gray-900 mb-2">Share link</h3>
    ${note ? `<p class="text-xs text-gray-500 mb-2">${esc(note)}</p>` : ''}
    <input type="text" readonly class="w-full mb-3 text-xs" value="${esc(url)}">
    <div class="flex gap-2">
      <button class="btn flex-1" data-c>Close</button>
      <button class="btn flex-1 bg-emerald-500 text-white border-emerald-500 hover:bg-emerald-600" data-cp>Copy</button>
    </div>`);
  const inp = o.querySelector('input');
  inp.focus(); inp.select();
  o.querySelector('[data-c]').onclick = () => o.remove();
  o.querySelector('[data-cp]').onclick = () => {
    inp.select();
    let ok = false;
    try { ok = document.execCommand('copy'); } catch (e) {}
    toast(ok ? 'Link copied' : 'Press Ctrl/Cmd + C to copy the link');
  };
}
// Compact share links: only the essentials are kept (matches/times are rebuilt on open), then deflated
function compactState() {
  return {
    n: state.eventName, d: state.eventDate, s: state.dayStarts, u: state.playUntil, m: state.matchMin, c: state.courts,
    k: state.categories.map(cat => {
      const tmp = { ...cat, teams: [...cat.teams], teamGroups: [...(cat.teamGroups || [])], matches: [] };
      buildMatches(tmp);
      const sc = tmp.matches.map(m => {
        const r = cat.matches.find(x => x.id === m.id);
        return r && (r.score1 !== '' || r.score2 !== '') ? r.score1 + '-' + r.score2 : '';
      }).join(',').replace(/,+$/, '');
      return [cat.name, cat.color, cat.format, cat.groups, cat.teams, (cat.teamGroups || []).join(''), sc];
    })
  };
}
function expandState(o) {
  const st = { pwHash: '', eventName: o.n ?? '', eventDate: o.d, dayStarts: o.s, playUntil: o.u, matchMin: o.m, courts: o.c, categories: [] };
  o.k.forEach((k, i) => {
    const cat = { id: 'cat' + Date.now() + i, name: k[0], color: k[1], format: k[2], groups: k[3], teams: k[4], teamGroups: k[5].split(''), matches: [] };
    buildMatches(cat);
    const sc = k[6].split(',');
    cat.matches.forEach((m, j) => { if (sc[j]) { const [a, b] = sc[j].split('-'); m.score1 = a; m.score2 = b ?? ''; } });
    st.categories.push(cat);
  });
  state = st;
  scheduleAll();
}
const toB64 = u8 => { let b = ''; u8.forEach(x => { b += String.fromCharCode(x); }); return btoa(b).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, ''); };
const fromB64 = t => Uint8Array.from(atob(t.replace(/-/g, '+').replace(/_/g, '/')), c => c.charCodeAt(0));
async function packData(o) {
  const raw = new TextEncoder().encode(JSON.stringify(o));
  let best = 'j' + toB64(raw);
  if (window.CompressionStream) {
    try {
      const z = new Uint8Array(await new Response(new Blob([raw]).stream().pipeThrough(new CompressionStream('deflate-raw'))).arrayBuffer());
      const c = 'z' + toB64(z);
      if (c.length < best.length) best = c;
    } catch (e) {}
  }
  return best;
}
async function unpackData(t) {
  let bytes = fromB64(t.slice(1));
  if (t[0] === 'z') bytes = new Uint8Array(await new Response(new Blob([bytes]).stream().pipeThrough(new DecompressionStream('deflate-raw'))).arrayBuffer());
  return JSON.parse(new TextDecoder().decode(bytes));
}

async function shareLink() {
  let url = location.href.split('#')[0];
  const live = !!db;
  if (!db) {
    // No database: the link carries a compressed snapshot of the schedule (no password hash)
    url += '#d=' + await packData(compactState());
  }
  let note = live ? 'Anyone with this link can follow along live.' : 'Snapshot link: it will not update live.';
  if (!/^https?:$/.test(location.protocol) || /^(localhost|127\.|192\.168\.|10\.)/.test(location.hostname)) {
    note = 'Heads up: this page is not on a public website, so this link will only open on this computer. Upload the file to a host (Netlify, GitHub Pages, etc.) and share that address. ' + note;
  }
  if (navigator.share) {
    try { await navigator.share({ title: 'MatchBoard', text: 'Live match schedule', url }); return; }
    catch (e) { if (e.name === 'AbortError') return; }
  }
  try {
    await navigator.clipboard.writeText(url);
    toast('Link copied. ' + note);
  } catch (e) {
    linkDialog(url, note);
  }
}
document.getElementById('shareBtn').addEventListener('click', shareLink);

// Open a snapshot link (only used when Firebase is not connected)
function openSnapshotFromHash() {
  if (db || !location.hash.startsWith('#d=')) return;
  unpackData(location.hash.slice(3))
    .then(o => { expandState(o); syncSetupInputs(); render(); })
    .catch(e => { console.error('Bad share link', e); toast('That share link could not be opened.'); });
}
openSnapshotFromHash();
window.addEventListener('hashchange', openSnapshotFromHash);

