function refreshDerived(catId) {
  const cat = getCat(catId);
  const st = document.getElementById('standings-' + cat.id);
  if (st) st.innerHTML = renderStandings(cat);
  document.querySelectorAll('[data-ko]').forEach(s => {
    const [cid, mid, side] = s.dataset.ko.split('|');
    if (cid !== cat.id) return;
    const m = cat.matches.find(x => x.id === mid);
    if (m) s.textContent = displayName(cat, m, +side);
  });
  renderSchedule();
  renderNextUp();
}

// ============================================
// SCORE INPUT HANDLING
// ============================================
document.addEventListener('input', e => {
  if (!e.target.classList.contains('score-box')) return;
  e.target.value = e.target.value.replace(/[^0-9]/g, '');
  e.target.classList.toggle('filled', e.target.value !== '');
});
document.addEventListener('change', e => {
  const t = e.target;
  if (!t.classList.contains('score-box')) return;
  const cat = getCat(t.dataset.cat);
  const m = cat && cat.matches.find(x => x.id === t.dataset.match);
  if (!m || !editMode) return;
  m['score' + t.dataset.side] = t.value;
  saveScore(cat, m, t.dataset.side, t.value);
  refreshDerived(cat.id);
});
document.addEventListener('keydown', e => {
  if (e.key !== 'Enter' || !e.target.classList.contains('score-box')) return;
  e.preventDefault();
  const all = Array.from(document.querySelectorAll('.score-box'));
  const next = all[all.indexOf(e.target) + 1];
  if (next) { next.focus(); next.select(); } else e.target.blur();
});
document.addEventListener('focusout', () => {
  if (!pendingRemote) return;
  setTimeout(() => { if (pendingRemote && !isTyping()) { const d = pendingRemote; pendingRemote = null; applyRemote(d); } }, 100);
});

// ============================================
// ACTIONS
// ============================================
function changed(cat) {
  if (cat) buildMatches(cat);
  scheduleAll();
  render();
  save();
}

function updateCatName(catId, name) { getCat(catId).name = name.trim() || 'Untitled'; render(); save(); }
function updateCatColor(catId, color) { getCat(catId).color = color; render(); save(); }
function updateCatFormat(catId, format) {
  const cat = getCat(catId);
  cat.format = format;
  if (!cat.groups) cat.groups = 2;
  changed(cat);
}
function updateCatGroups(catId, groups) { const cat = getCat(catId); cat.groups = parseInt(groups); changed(cat); }
function deleteCategory(catId) {
  const cat = getCat(catId);
  const doDelete = () => { state.categories = state.categories.filter(c => c.id !== catId); changed(); };
  if (cat.teams.length) confirmDialog(`Delete "${cat.name}" and all its matches?`, doDelete, 'Delete');
  else doDelete();
}

function addTeam(catId) {
  const input = document.getElementById(`teamInput-${catId}`);
  const cat = getCat(catId);
  const names = [...new Set(input.value.split(',').map(s => s.trim()).filter(Boolean))];
  if (!names.length) return;
  const dup = names.filter(n => cat.teams.some(t => t.toLowerCase() === n.toLowerCase()));
  if (dup.length) { toast(`Already in this category: ${dup.join(', ')}`); return; }
  if (cat.teams.length + names.length > 16) { toast("Maximum 16 teams per category!"); return; }
  alignGroups(cat);
  const sel = document.getElementById(`teamGroup-${catId}`);
  const g = sel ? sel.value : 'A';

  names.forEach(n => { cat.teams.push(n); cat.teamGroups.push(g); });
  savedGroupSelections[catId] = g;

  changed(cat);
  const again = document.getElementById(`teamInput-${catId}`);
  if (again) again.focus();
}

function updateTeamName(catId, index, newName) {
  const cat = getCat(catId);
  const oldName = cat.teams[index], cleanName = newName.trim();
  if (!cleanName) { toast("Team name cannot be empty."); render(); return; }
  if (cat.teams.some((t, i) => i !== index && t.toLowerCase() === cleanName.toLowerCase())) { toast("That team name already exists in this category."); render(); return; }
  cat.teams[index] = cleanName;
  cat.matches.forEach(m => { if (m.team1 === oldName) m.team1 = cleanName; if (m.team2 === oldName) m.team2 = cleanName; });
  render();
  save();
}

function updateTeamGroup(catId, index, newGroup) {
  const cat = getCat(catId);
  alignGroups(cat);
  cat.teamGroups[index] = newGroup;
  changed(cat);
}

function removeTeam(catId, index) {
  const cat = getCat(catId);
  const removed = cat.teams[index];
  confirmDialog(`Remove "${removed}"? This will also delete their scheduled matches.`, () => {
    alignGroups(cat);
    cat.teams.splice(index, 1);
    cat.teamGroups.splice(index, 1);
    changed(cat);
  });
}

