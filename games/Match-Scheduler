// ============================================
if (db) {
  db.ref(DB_PATH).on('value', snap => {
    if (echo) return;
    loaded = true;
    const d = snap.val();
    if (!d) return;
    if (isTyping()) { pendingRemote = d; return; }
    applyRemote(d);
  });
}

